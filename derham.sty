\cs_new_protected:Npn \__derham_indexed_key:n #1
  {
    \regex_extract_once:nVNTF
      {\A (space|discrete-space|operator|discrete-operator|map|map-direction)-([0-9]+) \Z}
      \l_keys_key_str \l__derham_key_match_seq
      {
        \tl_set:Nx \l__derham_key_tl {\seq_item:Nn \l__derham_key_match_seq {2}}
        \tl_set:Nx \l__derham_temp_tl {\seq_item:Nn \l__derham_key_match_seq {3}}
        \str_case:Vn \l__derham_key_tl
          {
            {space}{\prop_put:NVn \l__derham_space_override_prop \l__derham_temp_tl {#1}}
            {discrete-space}{\prop_put:NVn \l__derham_discrete_space_override_prop \l__derham_temp_tl {#1}}
            {operator}{\prop_put:NVn \l__derham_operator_override_prop \l__derham_temp_tl {#1}}
            {discrete-operator}{\prop_put:NVn \l__derham_discrete_operator_override_prop \l__derham_temp_tl {#1}}
            {map}{\prop_put:NVn \l__derham_map_override_prop \l__derham_temp_tl {#1}}
            {map-direction}{
              \str_if_eq:nnTF {#1}{up}
                {\prop_put:NVn \l__derham_map_direction_override_prop \l__derham_temp_tl {up}}
                {\str_if_eq:nnTF {#1}{down}
                  {\prop_put:NVn \l__derham_map_direction_override_prop \l__derham_temp_tl {down}}
                  {\msg_error:nnn {derham}{invalid-direction}{#1}}}
            }
          }
      }
      {\msg_error:nnx {derham}{unknown-key}{\l_keys_key_str}}
  }
\msg_new:nnn {derham}{invalid-direction}{Map~direction~must~be~up~or~down;~got~'#1'.}
\msg_new:nnn {derham}{unknown-key}{Unknown~option~'#1'.}
\cs_generate_variant:Nn \regex_extract_once:nnNTF {nVNTF}
\int_step_inline:nnnn {0}{1}{3}
  {
    \keys_define:nn {derham}
      {
        space-#1 .code:n = {\prop_put:Nnn \l__derham_space_override_prop {#1}{##1}},
        discrete-space-#1 .code:n = {\prop_put:Nnn \l__derham_discrete_space_override_prop {#1}{##1}},
        operator-#1 .code:n = {\prop_put:Nnn \l__derham_operator_override_prop {#1}{##1}},
        discrete-operator-#1 .code:n = {\prop_put:Nnn \l__derham_discrete_operator_override_prop {#1}{##1}},
        map-#1 .code:n = {\prop_put:Nnn \l__derham_map_override_prop {#1}{##1}},
        map-direction-#1 .choice:,
        map-direction-#1 / down .code:n = {\prop_put:Nnn \l__derham_map_direction_override_prop {#1}{down}},
        map-direction-#1 / up .code:n = {\prop_put:Nnn \l__derham_map_direction_override_prop {#1}{up}}
      }
  }

