\cs_new_protected:Npn \__derham_engine_clear:
  {
    \seq_clear:N \l__derham_rows_seq
    \seq_clear:N \l__derham_connections_seq
    \prop_clear:N \l__derham_row_index_prop
    \prop_clear:N \l__derham_row_space_prop
    \prop_clear:N \l__derham_row_operator_prop
    \prop_clear:N \l__derham_row_direction_prop
    \prop_clear:N \l__derham_connection_prop
    \int_zero:N \l__derham_connection_int
  }
\cs_new_protected:Npn \__derham_default_space:nnN #1#2#3
  {
    \str_case:nnF {#1}
      {
        {top}{\__derham_space:nnN {top}{#2} #3}
        {bottom}{\__derham_space:nnN {bottom}{#2} #3}
        {reference}{
          \str_if_eq:VnTF \l__derham_spaces_tl {sobolev}
            {\tl_set:Nn #3 {H\Lambda^{#2}(\widehat{\Omega})}}
            {\tl_set:Nn #3 {\widehat{V}^{#2}}}
        }
        {coefficients}{\tl_set:Nn #3 {\mathbb{R}^{N_{#2}}}}
        {dual}{\tl_set:Nn #3 {(V_h^{#2})^*}}
        {conforming}{\tl_set:Nn #3 {V_h^{#2,c}}}
        {broken}{\tl_set:Nn #3 {V_h^{#2}}}
      }
      {\tl_set:Nn #3 {V^{#2}}}
  }
\cs_new_protected:Npn \__derham_default_operator:nnN #1#2#3
  {
    \str_case:nnF {#1}
