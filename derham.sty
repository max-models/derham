\cs_new_protected:Npn \__derham_check_list:Nnn #1#2#3
  {
    \clist_if_empty:NF #1
      {
        \int_compare:nNnF {\clist_count:N #1} = {#3}
          {
            \msg_error:nnxxx {derham}{wrong-length}{#2}{\int_eval:n {#3}}{\int_eval:n {\clist_count:N #1}}
            \bool_set_false:N \l__derham_valid_bool
          }
      }
  }
\cs_new_protected:Npn \__derham_check_indices:Nnn #1#2#3
  {
    \prop_map_inline:Nn #1
      {
        \int_compare:nNnT {##1} > {#3}
          {\msg_error:nnnn {derham}{bad-index}{##1}{#2}\bool_set_false:N \l__derham_valid_bool}
      }
  }
\cs_new_protected:Npn \__derham_validate:
  {
    \bool_set_true:N \l__derham_valid_bool
    \int_compare:nNnF {\l__derham_dimension_int} > {0}
      {\msg_error:nnx {derham}{invalid-dimension}{\int_use:N \l__derham_dimension_int}\bool_set_false:N \l__derham_valid_bool}
    \str_if_eq:VnT \l__derham_notation_tl {vector}
      {\int_compare:nNnT {\l__derham_dimension_int} > {3}
        {\msg_error:nn {derham}{vector-dimension}\bool_set_false:N \l__derham_valid_bool}}
    \int_compare:nNnT {\l__derham_to_int} = {-1}
      {\int_set_eq:NN \l__derham_to_int \l__derham_dimension_int}
    \bool_if:NT \l__derham_valid_bool
      {
        \bool_if:nF
          {\int_compare_p:n {\l__derham_from_int >= 0}
           && \int_compare_p:n {\l__derham_from_int < \l__derham_to_int}
           && \int_compare_p:n {\l__derham_to_int <= \l__derham_dimension_int}}
          {
            \msg_error:nnxx {derham}{invalid-range}
              {\int_use:N \l__derham_from_int}{\int_use:N \l__derham_to_int}
            \bool_set_false:N \l__derham_valid_bool
          }
        \__derham_check_list:Nnn \l__derham_custom_spaces_clist {custom-spaces} {\l__derham_dimension_int+1}
        \__derham_check_list:Nnn \l__derham_custom_discrete_spaces_clist {custom-discrete-spaces} {\l__derham_dimension_int+1}
        \__derham_check_list:Nnn \l__derham_operators_clist {operators} {\l__derham_dimension_int}
        \__derham_check_list:Nnn \l__derham_discrete_operators_clist {discrete-operators} {\l__derham_dimension_int}
        \__derham_check_list:Nnn \l__derham_maps_clist {maps} {\l__derham_dimension_int+1}
        \__derham_check_list:Nnn \l__derham_reference_spaces_clist {reference-spaces} {\l__derham_dimension_int+1}
        \__derham_check_list:Nnn \l__derham_reference_operators_clist {reference-operators} {\l__derham_dimension_int}
        \__derham_check_list:Nnn \l__derham_coefficient_spaces_clist {coefficient-spaces} {\l__derham_dimension_int+1}
        \__derham_check_list:Nnn \l__derham_coefficient_operators_clist {coefficient-operators} {\l__derham_dimension_int}
        \__derham_check_list:Nnn \l__derham_dual_spaces_clist {dual-spaces} {\l__derham_dimension_int+1}
        \__derham_check_list:Nnn \l__derham_dual_operators_clist {dual-operators} {\l__derham_dimension_int}
        \__derham_check_list:Nnn \l__derham_broken_spaces_clist {broken-spaces} {\l__derham_dimension_int+1}
        \__derham_check_list:Nnn \l__derham_broken_operators_clist {broken-operators} {\l__derham_dimension_int}
        \__derham_check_indices:Nnn \l__derham_space_override_prop {space} {\l__derham_dimension_int}
        \__derham_check_indices:Nnn \l__derham_discrete_space_override_prop {discrete-space} {\l__derham_dimension_int}
        \__derham_check_indices:Nnn \l__derham_operator_override_prop {operator} {\l__derham_dimension_int-1}
        \__derham_check_indices:Nnn \l__derham_discrete_operator_override_prop {discrete-operator} {\l__derham_dimension_int-1}
        \__derham_check_indices:Nnn \l__derham_map_override_prop {map} {\l__derham_dimension_int}
        \__derham_check_indices:Nnn \l__derham_map_direction_override_prop {map-direction} {\l__derham_dimension_int}
      }
  }

% The renderer receives each cell as space + outgoing arrows. All labels are
% inserted unexpanded; tikz-cd owns spacing and arrow placement.
\cs_new_protected:Npn \__derham_space:nnN #1#2#3
  {
    \tl_clear:N #3
    \str_if_eq:nnTF {#1}{bottom}
      {
        \prop_get:NnNTF \l__derham_discrete_space_override_prop {#2} #3 {}
          {
            \clist_if_empty:NTF \l__derham_custom_discrete_spaces_clist
              {\tl_set:Nn #3 {V_h^{#2}}}
              {\tl_set:Nx #3 {\exp_not:o {\clist_item:Nn \l__derham_custom_discrete_spaces_clist {\int_eval:n {#2+1}}}}}
          }
      }
      {
        \prop_get:NnNTF \l__derham_space_override_prop {#2} #3 {}
          {
            \clist_if_empty:NTF \l__derham_custom_spaces_clist
              {
                \str_if_eq:VnTF \l__derham_spaces_tl {sobolev}
                  {
                    \str_if_eq:VnTF \l__derham_notation_tl {vector}
                      {\__derham_vector_space:nN {#2} #3}
                      {\tl_set:Nn #3 {H\Lambda^{#2}(\Omega)}}
                  }
                  {\tl_set:Nn #3 {V^{#2}}}
              }
              {\tl_set:Nx #3 {\exp_not:o {\clist_item:Nn \l__derham_custom_spaces_clist {\int_eval:n {#2+1}}}}}
          }
      }
  }
\cs_new_protected:Npn \__derham_vector_space:nN #1#2
  {
    \int_case:nnF {\l__derham_dimension_int}
      {
        {1}{\int_compare:nNnTF {#1} = {0} {\tl_set:Nn #2 {H^1(\Omega)}} {\tl_set:Nn #2 {L^2(\Omega)}}}
        {2}{\int_case:nn {#1} {{0}{\tl_set:Nn #2 {H^1(\Omega)}}{1}{\tl_set:Nn #2 {H(\operatorname{curl};\Omega)}}{2}{\tl_set:Nn #2 {L^2(\Omega)}}}}
        {3}{\int_case:nn {#1} {{0}{\tl_set:Nn #2 {H^1(\Omega)}}{1}{\tl_set:Nn #2 {H(\operatorname{curl};\Omega)}}{2}{\tl_set:Nn #2 {H(\operatorname{div};\Omega)}}{3}{\tl_set:Nn #2 {L^2(\Omega)}}}}
      }{}
  }
\cs_new_protected:Npn \__derham_operator:nnN #1#2#3
  {
    \tl_clear:N #3
    \str_if_eq:nnTF {#1}{bottom}
      {
        \prop_get:NnNTF \l__derham_discrete_operator_override_prop {#2} #3 {}
          {
            \clist_if_empty:NTF \l__derham_discrete_operators_clist
              {\tl_set:Nn #3 {d_h^{#2}}}
              {\tl_set:Nx #3 {\exp_not:o {\clist_item:Nn \l__derham_discrete_operators_clist {\int_eval:n {#2+1}}}}}
          }
      }
      {
        \prop_get:NnNTF \l__derham_operator_override_prop {#2} #3 {}
          {
            \clist_if_empty:NTF \l__derham_operators_clist
              {
                \str_if_eq:VnTF \l__derham_notation_tl {vector}
                  {\__derham_vector_operator:nN {#2} #3}
                  {\tl_set:Nn #3 {d^{#2}}}
              }
              {\tl_set:Nx #3 {\exp_not:o {\clist_item:Nn \l__derham_operators_clist {\int_eval:n {#2+1}}}}}
          }
      }
  }
\cs_new_protected:Npn \__derham_vector_operator:nN #1#2
  {
    \int_case:nnF {\l__derham_dimension_int}
      {
        {1}{\tl_set:Nn #2 {\frac{\mathrm d}{\mathrm dx}}}
        {2}{\int_compare:nNnTF {#1} = {0} {\tl_set:Nn #2 {\operatorname{grad}}} {\tl_set:Nn #2 {\operatorname{curl}}}}
        {3}{\int_case:nn {#1} {{0}{\tl_set:Nn #2 {\operatorname{grad}}}{1}{\tl_set:Nn #2 {\operatorname{curl}}}{2}{\tl_set:Nn #2 {\operatorname{div}}}}}
      }{}
  }
\cs_new_protected:Npn \__derham_map:nN #1#2
  {
    \prop_get:NnNTF \l__derham_map_override_prop {#1} #2 {}
      {
        \clist_if_empty:NTF \l__derham_maps_clist
          {\tl_set:Nx #2 {\exp_not:V \l__derham_projection_tl ^{#1}}}
          {\tl_set:Nx #2 {\exp_not:o {\clist_item:Nn \l__derham_maps_clist {\int_eval:n {#1+1}}}}}
      }
  }
